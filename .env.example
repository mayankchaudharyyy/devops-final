# =================================================================
# RFQ Auction Bidding System - Environment Configuration Example
# =================================================================

# Backend Configuration
PORT=5000
NODE_ENV=production
# MongoDB Atlas Connection URI (Replace with your Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>/<dbname>?appName=RFQ
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Frontend Configuration (for local development outside Docker)
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

